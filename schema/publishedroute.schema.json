{
  "$defs": {
    "ElevationProfileSection": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "elevation_profile",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "ElevationProfileSection",
      "type": "object"
    },
    "GallerySection": {
      "additionalProperties": false,
      "properties": {
        "media": {
          "items": {
            "type": "string"
          },
          "title": "Media",
          "type": "array"
        },
        "type": {
          "const": "gallery",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "media"
      ],
      "title": "GallerySection",
      "type": "object"
    },
    "HardestSection": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "minProperties": 1,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "km": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Km"
        },
        "media": {
          "title": "Media",
          "type": "string"
        }
      },
      "required": [
        "media"
      ],
      "title": "HardestSection",
      "type": "object"
    },
    "Itrs": {
      "additionalProperties": false,
      "description": "ITRS assessment of the whole route (5.3). Every sub-field is optional (P11).",
      "properties": {
        "assessed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessed By"
        },
        "assessed_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessed On"
        },
        "endurance": {
          "anyOf": [
            {
              "enum": [
                "green",
                "blue",
                "red",
                "black",
                "orange"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endurance"
        },
        "exposure": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exposure"
        },
        "technical": {
          "anyOf": [
            {
              "enum": [
                "green",
                "blue",
                "red",
                "black",
                "orange"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Technical"
        },
        "wilderness": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wilderness"
        }
      },
      "title": "Itrs",
      "type": "object"
    },
    "NearbyService": {
      "description": "A service point within `nearby_services_m` of the track, at its km (5.3).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "km": {
          "title": "Km",
          "type": "number"
        }
      },
      "required": [
        "id",
        "km"
      ],
      "title": "NearbyService",
      "type": "object"
    },
    "PublishedMedia": {
      "description": "An image of the route (5.3): the WebP sizes and what the EXIF said, keyed by source path.",
      "properties": {
        "author": {
          "title": "Author",
          "type": "string"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "sizes": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Sizes",
          "type": "object"
        },
        "taken_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taken At"
        }
      },
      "required": [
        "author",
        "license"
      ],
      "title": "PublishedMedia",
      "type": "object"
    },
    "PublishedSegment": {
      "description": "Normalised segment (5.3): a gap is a segment whose attributes are all None.",
      "properties": {
        "end_km": {
          "title": "End Km",
          "type": "number"
        },
        "itrs_technical": {
          "anyOf": [
            {
              "enum": [
                "green",
                "blue",
                "red",
                "black",
                "orange"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Itrs Technical"
        },
        "start_km": {
          "title": "Start Km",
          "type": "number"
        },
        "surface": {
          "anyOf": [
            {
              "enum": [
                "asphalt",
                "paving",
                "gravel",
                "trail",
                "boardwalk",
                "snow"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Surface"
        },
        "traffic": {
          "anyOf": [
            {
              "enum": [
                "separated",
                "quiet",
                "busy"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traffic"
        }
      },
      "required": [
        "start_km",
        "end_km"
      ],
      "title": "PublishedSegment",
      "type": "object"
    },
    "ServiceGap": {
      "description": "The longest stretch without a service of the theme's first categories (7.11).",
      "properties": {
        "end_km": {
          "title": "End Km",
          "type": "number"
        },
        "km": {
          "title": "Km",
          "type": "number"
        },
        "start_km": {
          "title": "Start Km",
          "type": "number"
        }
      },
      "required": [
        "km",
        "start_km",
        "end_km"
      ],
      "title": "ServiceGap",
      "type": "object"
    },
    "TextSection": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Content",
          "type": "object"
        },
        "type": {
          "const": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "content"
      ],
      "title": "TextSection",
      "type": "object"
    },
    "VideoSection": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "video",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "type",
        "url"
      ],
      "title": "VideoSection",
      "type": "object"
    }
  },
  "description": "route.json (5.3). Media rule: `cover_image` is a ready path relative to the data root\n(`routes/<id>/media/cover-<hash>-400.webp`); everything else (`hardest_section.media`, gallery\n`media` entries) is a source key into `media`, where the sizes and the location are.",
  "properties": {
    "ascent_m": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ascent M"
    },
    "bbox": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Bbox",
      "type": "array"
    },
    "cover_image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cover Image"
    },
    "difficulty": {
      "anyOf": [
        {
          "enum": [
            "easy",
            "moderate",
            "demanding"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Difficulty"
    },
    "dominant_surface": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dominant Surface"
    },
    "elevation_source": {
      "anyOf": [
        {
          "enum": [
            "gpx",
            "geojson",
            "mml_dem"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elevation Source"
    },
    "gpx": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gpx"
    },
    "gpx_bytes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gpx Bytes"
    },
    "hardest_image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hardest Image"
    },
    "hardest_section": {
      "anyOf": [
        {
          "$ref": "#/$defs/HardestSection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "itrs": {
      "anyOf": [
        {
          "$ref": "#/$defs/Itrs"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "itrs_technical_shares": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Itrs Technical Shares"
    },
    "length_km": {
      "title": "Length Km",
      "type": "number"
    },
    "lipas_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lipas Id"
    },
    "longest_service_gap": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/ServiceGap"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Longest Service Gap"
    },
    "maintainer": {
      "anyOf": [
        {
          "enum": [
            "municipal",
            "non_municipal"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maintainer"
    },
    "maintenance_note": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maintenance Note"
    },
    "maintenance_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maintenance Url"
    },
    "media": {
      "additionalProperties": {
        "$ref": "#/$defs/PublishedMedia"
      },
      "default": {},
      "title": "Media",
      "type": "object"
    },
    "name": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "title": "Name",
      "type": "object"
    },
    "nearby_services": {
      "default": [],
      "items": {
        "$ref": "#/$defs/NearbyService"
      },
      "title": "Nearby Services",
      "type": "array"
    },
    "non_municipal_reasons": {
      "default": [],
      "items": {
        "enum": [
          "private_road_no_permission",
          "unmarked",
          "unmaintained",
          "everymans_rights_terrain",
          "seasonal"
        ],
        "type": "string"
      },
      "title": "Non Municipal Reasons",
      "type": "array"
    },
    "profile": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "type": "array"
      },
      "title": "Profile",
      "type": "array"
    },
    "seasons": {
      "items": {
        "type": "string"
      },
      "title": "Seasons",
      "type": "array"
    },
    "sections": {
      "items": {
        "discriminator": {
          "mapping": {
            "elevation_profile": "#/$defs/ElevationProfileSection",
            "gallery": "#/$defs/GallerySection",
            "text": "#/$defs/TextSection",
            "video": "#/$defs/VideoSection"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TextSection"
          },
          {
            "$ref": "#/$defs/GallerySection"
          },
          {
            "$ref": "#/$defs/VideoSection"
          },
          {
            "$ref": "#/$defs/ElevationProfileSection"
          }
        ]
      },
      "title": "Sections",
      "type": "array"
    },
    "segments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PublishedSegment"
      },
      "title": "Segments",
      "type": "array"
    },
    "separated_share": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Separated Share"
    },
    "service_gaps": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Service Gaps"
    },
    "surface_shares": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Surface Shares"
    },
    "themes": {
      "items": {
        "type": "string"
      },
      "title": "Themes",
      "type": "array"
    },
    "track": {
      "title": "Track",
      "type": "string"
    },
    "traffic_shares": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "number"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Traffic Shares"
    },
    "winter_maintenance": {
      "anyOf": [
        {
          "enum": [
            "plowed",
            "groomed",
            "none"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Winter Maintenance"
    }
  },
  "required": [
    "id",
    "name",
    "themes",
    "seasons",
    "length_km",
    "bbox",
    "track",
    "profile",
    "sections"
  ],
  "title": "PublishedRoute",
  "type": "object"
}
