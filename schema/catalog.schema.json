{
  "$defs": {
    "CatalogProject": {
      "properties": {
        "area": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Area"
        },
        "default_language": {
          "title": "Default Language",
          "type": "string"
        },
        "default_theme": {
          "title": "Default Theme",
          "type": "string"
        },
        "feedback": {
          "anyOf": [
            {
              "$ref": "#/$defs/Feedback"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "languages": {
          "items": {
            "type": "string"
          },
          "title": "Languages",
          "type": "array"
        },
        "name": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Name",
          "type": "object"
        },
        "subtitle": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Subtitle",
          "type": "object"
        }
      },
      "required": [
        "name",
        "subtitle",
        "languages",
        "default_language",
        "default_theme"
      ],
      "title": "CatalogProject",
      "type": "object"
    },
    "Colors": {
      "additionalProperties": false,
      "properties": {
        "highlight": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Highlight",
          "type": "string"
        },
        "primary": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Primary",
          "type": "string"
        },
        "route": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Route",
          "type": "string"
        }
      },
      "required": [
        "primary",
        "route",
        "highlight"
      ],
      "title": "Colors",
      "type": "object"
    },
    "Feedback": {
      "additionalProperties": false,
      "properties": {
        "github_repo": {
          "title": "Github Repo",
          "type": "string"
        },
        "issue_form": {
          "title": "Issue Form",
          "type": "string"
        }
      },
      "required": [
        "github_repo",
        "issue_form"
      ],
      "title": "Feedback",
      "type": "object"
    },
    "Itrs": {
      "additionalProperties": false,
      "description": "ITRS assessment of the whole route (5.3). Every sub-field is optional (P11).",
      "properties": {
        "assessed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessed By"
        },
        "assessed_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assessed On"
        },
        "endurance": {
          "anyOf": [
            {
              "enum": [
                "green",
                "blue",
                "red",
                "black",
                "orange"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endurance"
        },
        "exposure": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exposure"
        },
        "technical": {
          "anyOf": [
            {
              "enum": [
                "green",
                "blue",
                "red",
                "black",
                "orange"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Technical"
        },
        "wilderness": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wilderness"
        }
      },
      "title": "Itrs",
      "type": "object"
    },
    "Presentation": {
      "additionalProperties": false,
      "description": "Which route facts come first in this theme (5.2). Lists hold 5.7 identifiers only,\nin display order; the frontend falls back to length, ascent, elevation and cover image.",
      "properties": {
        "band": {
          "default": [],
          "items": {
            "enum": [
              "elevation",
              "surface",
              "traffic",
              "itrs_technical"
            ],
            "type": "string"
          },
          "title": "Band",
          "type": "array"
        },
        "filters": {
          "default": [],
          "items": {
            "enum": [
              "length",
              "ascent",
              "difficulty",
              "itrs_technical",
              "dominant_surface",
              "separated_share",
              "winter_maintenance"
            ],
            "type": "string"
          },
          "title": "Filters",
          "type": "array"
        },
        "hero_image": {
          "default": "cover_image",
          "enum": [
            "cover_image",
            "hardest_section"
          ],
          "title": "Hero Image",
          "type": "string"
        },
        "key_figures": {
          "default": [],
          "items": {
            "enum": [
              "length",
              "ascent",
              "difficulty",
              "itrs_technical",
              "itrs_endurance",
              "itrs_exposure",
              "itrs_wilderness",
              "dominant_surface",
              "surface_shares",
              "separated_share",
              "winter_maintenance",
              "longest_service_gap"
            ],
            "type": "string"
          },
          "title": "Key Figures",
          "type": "array"
        },
        "service_categories_first": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Service Categories First",
          "type": "array"
        }
      },
      "title": "Presentation",
      "type": "object"
    },
    "RouteSummary": {
      "description": "The route as listed in catalog.json: what the list card and the filters need (5.6).",
      "properties": {
        "ascent_m": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ascent M"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "cover_image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cover Image"
        },
        "difficulty": {
          "anyOf": [
            {
              "enum": [
                "easy",
                "moderate",
                "demanding"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difficulty"
        },
        "dominant_surface": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dominant Surface"
        },
        "hardest_image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hardest Image"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "itrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/Itrs"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "length_km": {
          "title": "Length Km",
          "type": "number"
        },
        "maintainer": {
          "anyOf": [
            {
              "enum": [
                "municipal",
                "non_municipal"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maintainer"
        },
        "name": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Name",
          "type": "object"
        },
        "seasons": {
          "items": {
            "type": "string"
          },
          "title": "Seasons",
          "type": "array"
        },
        "separated_share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Separated Share"
        },
        "surface_shares": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Surface Shares"
        },
        "themes": {
          "items": {
            "type": "string"
          },
          "title": "Themes",
          "type": "array"
        },
        "winter_maintenance": {
          "anyOf": [
            {
              "enum": [
                "plowed",
                "groomed",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Winter Maintenance"
        }
      },
      "required": [
        "id",
        "name",
        "themes",
        "seasons",
        "length_km",
        "bbox"
      ],
      "title": "RouteSummary",
      "type": "object"
    },
    "Theme": {
      "additionalProperties": false,
      "properties": {
        "basemap": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basemap"
        },
        "colors": {
          "$ref": "#/$defs/Colors"
        },
        "dark": {
          "default": false,
          "title": "Dark",
          "type": "boolean"
        },
        "default_layers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Default Layers",
          "type": "array"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Icon"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Name",
          "type": "object"
        },
        "order": {
          "title": "Order",
          "type": "integer"
        },
        "presentation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Presentation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tagline": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "minProperties": 1,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tagline"
        }
      },
      "required": [
        "id",
        "name",
        "order",
        "colors"
      ],
      "title": "Theme",
      "type": "object"
    }
  },
  "properties": {
    "coverage": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Coverage",
      "type": "object"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "layers": {
      "default": [],
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Layers",
      "type": "array"
    },
    "overview": {
      "title": "Overview",
      "type": "string"
    },
    "project": {
      "$ref": "#/$defs/CatalogProject"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/RouteSummary"
      },
      "title": "Routes",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "services": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Services"
    },
    "themes": {
      "items": {
        "$ref": "#/$defs/Theme"
      },
      "title": "Themes",
      "type": "array"
    }
  },
  "required": [
    "generated_at",
    "project",
    "themes",
    "routes",
    "overview"
  ],
  "title": "Catalog",
  "type": "object"
}
