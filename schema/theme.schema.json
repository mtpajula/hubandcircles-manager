{
  "$defs": {
    "Colors": {
      "additionalProperties": false,
      "properties": {
        "highlight": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Highlight",
          "type": "string"
        },
        "primary": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Primary",
          "type": "string"
        },
        "route": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Route",
          "type": "string"
        }
      },
      "required": [
        "primary",
        "route",
        "highlight"
      ],
      "title": "Colors",
      "type": "object"
    },
    "Presentation": {
      "additionalProperties": false,
      "description": "Which route facts come first in this theme (5.2). Lists hold 5.7 identifiers only,\nin display order; the frontend falls back to length, ascent, elevation and cover image.",
      "properties": {
        "band": {
          "default": [],
          "items": {
            "enum": [
              "elevation",
              "surface",
              "traffic",
              "itrs_technical"
            ],
            "type": "string"
          },
          "title": "Band",
          "type": "array"
        },
        "filters": {
          "default": [],
          "items": {
            "enum": [
              "length",
              "ascent",
              "difficulty",
              "itrs_technical",
              "dominant_surface",
              "separated_share",
              "winter_maintenance"
            ],
            "type": "string"
          },
          "title": "Filters",
          "type": "array"
        },
        "hero_image": {
          "default": "cover_image",
          "enum": [
            "cover_image",
            "hardest_section"
          ],
          "title": "Hero Image",
          "type": "string"
        },
        "key_figures": {
          "default": [],
          "items": {
            "enum": [
              "length",
              "ascent",
              "difficulty",
              "itrs_technical",
              "itrs_endurance",
              "itrs_exposure",
              "itrs_wilderness",
              "dominant_surface",
              "surface_shares",
              "separated_share",
              "winter_maintenance",
              "longest_service_gap"
            ],
            "type": "string"
          },
          "title": "Key Figures",
          "type": "array"
        },
        "service_categories_first": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Service Categories First",
          "type": "array"
        }
      },
      "title": "Presentation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basemap": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Basemap"
    },
    "colors": {
      "$ref": "#/$defs/Colors"
    },
    "dark": {
      "default": false,
      "title": "Dark",
      "type": "boolean"
    },
    "default_layers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Default Layers",
      "type": "array"
    },
    "icon": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Icon"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "title": "Name",
      "type": "object"
    },
    "order": {
      "title": "Order",
      "type": "integer"
    },
    "presentation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Presentation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tagline": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tagline"
    }
  },
  "required": [
    "id",
    "name",
    "order",
    "colors"
  ],
  "title": "Theme",
  "type": "object"
}
