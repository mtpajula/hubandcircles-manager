# Root of the source data repo (project.json, themes/, routes/, ...)
DATA_DIR=
# Large source files kept outside git (GeoTIFFs etc.)
SOURCE_FILES_DIR=
# Tile cache in XYZ layout
TILE_CACHE_DIR=
# Path to the go-pmtiles binary
PMTILES_BIN=
# National Land Survey of Finland API key
MML_API_KEY=
# Visit Finland API key
VF_API_KEY=
# Visit Finland secondary key (rotation)
VF_API_SECONDARY_KEY=
# GitHub token for reading issues and publishing
GITHUB_TOKEN=
# Default assessor name for ITRS assessments (Routes page); empty = last used in the session
ASSESSOR_NAME=
